# Copy this file to .env.local for local development.
# Never commit real secrets. See docs/DEPLOYMENT.md for full setup instructions.

# --- Public (embedded in the browser bundle at build time) ---
# Base URL the app is served from. Used for building invite links and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and anon (public) key. Safe to expose to the browser —
# access is enforced by Row Level Security, not by keeping this secret.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Cloudflare Turnstile site key (public). Leave blank in local dev to disable Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_, never sent to the browser) ---
# Supabase service-role key. Grants full database access, bypassing RLS.
# Only used in server-side route handlers via src/lib/supabase/service-role.ts.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection string, used only for scripts/migrations if needed
# outside the Supabase CLI (e.g. one-off maintenance jobs).
SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Cloudflare Turnstile secret key, verified server-side. Leave blank in local dev.
TURNSTILE_SECRET_KEY=

# Optional: Sentry DSN for error reporting. Leave blank to disable.
SENTRY_DSN=

# Set to "true" to enable the development fixture mode (seeded decks, forced
# scenarios) used by automated tests. Automatically disabled when NODE_ENV=production.
NEXT_PUBLIC_ENABLE_DEV_FIXTURES=false
